{
  "manifest_version": 3,
  "name": "Templater",
  "short_name": "Templater",
  "version": "1.0.0",
  "description": "Build once, paste anywhere. Create reusable message templates with dynamic [Field] placeholders.",
  "permissions": ["storage", "scripting", "activeTab", "clipboardWrite"],
  "host_permissions": ["https://raw.githubusercontent.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Templater — Build once, paste anywhere",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [{
    "resources": ["src/popup.html", "src/popup.js", "src/sync.js"],
    "matches": ["<all_urls>"]
  }],
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
