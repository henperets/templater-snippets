{
  "name": "templater",
  "displayName": "Templater",
  "description": "Build once, paste anywhere. Reusable text templates with fill-in [Fields], shared through a public Git repo.",
  "version": "1.0.0",
  "publisher": "henperets",
  "license": "MIT",
  "author": "Hen Perets",
  "icon": "icons/icon128.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/henperets/templater-snippets.git"
  },
  "homepage": "https://github.com/henperets/templater-snippets#readme",
  "bugs": {
    "url": "https://github.com/henperets/templater-snippets/issues"
  },
  "keywords": [
    "templates",
    "snippets",
    "canned-responses",
    "productivity",
    "chrome-extension",
    "vscode-extension"
  ],
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:templater.open"
  ],
  "main": "./src/extension.js",
  "scripts": {
    "test": "node --test",
    "check": "node --check src/sync.js && node --check src/popup.js && node --check src/extension.js && node --check src/content.js && node --check src/background.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "templater.open",
        "title": "Open Template Manager",
        "category": "Templater"
      }
    ],
    "keybindings": [
      {
        "command": "templater.open",
        "key": "ctrl+shift+alt+t",
        "mac": "cmd+shift+alt+t"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "templater.open",
          "group": "navigation",
          "when": "editorFocus"
        }
      ]
    }
  }
}
